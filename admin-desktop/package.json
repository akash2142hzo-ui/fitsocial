{
  "name": "@fitsocial/admin-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Local-only FitSocial Admin Studio demo",
  "main": "dist/electron/main.js",
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.electron.json",
    "start": "npm run build && node scripts/launch.mjs",
    "smoke": "npm run build && node scripts/launch.mjs --smoke-test"
  },
  "dependencies": { "react": "^19.2.0", "react-dom": "^19.2.0" },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "^42.0.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "jsdom": "^27.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
